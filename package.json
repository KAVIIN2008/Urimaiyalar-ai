{
  "name": "urimaiyalar-ai",
  "private": true,
  "version": "1.0.0",
  "description": "URIMAIYALAR OS — AI-Powered Business Intelligence & Operating System for MSMEs & Retailers",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server-prisma.ts",
    "build": "vite build && esbuild src/server-prisma.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "start:prod": "npx pm2 start ecosystem.config.cjs",
    "stop": "npx pm2 stop urimaiyalar-os",
    "restart": "npx pm2 restart urimaiyalar-os",
    "monit": "npx pm2 monit",
    "logs": "npx pm2 logs urimaiyalar-os",
    "preview": "vite preview",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-full-stack-live.mjs",
    "test:load": "node scripts/load-test-concurrent.mjs",
    "test:acceptance": "node scripts/test-acceptance-flow.mjs",
    "db:migrate": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "db:use-postgres": "node scripts/switch-to-postgres.mjs",
    "db:use-sqlite": "node scripts/switch-to-sqlite.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "5.19.1",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "serverless-http": "^4.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pm2": "^7.0.4",
    "prisma": "5.19.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
